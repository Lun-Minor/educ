<Window x:Class="educ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:educ"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>

        
        <Grid x:Name="StartScreen" >
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">

                <TextBlock Text="ШутИКроль" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" Margin="10"/>

                <Button Content="Войти" Height="65" FontSize="30" Margin="10" Background="#60C2E2" Foreground="White" Click="BtnLogin_Click"/>

                <Button Content="Зарегистрироваться" Height="65" FontSize="30" Margin="10" Background="#38A803" Foreground="White" Click="BtnRegister_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
<Page x:Class="educ.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:educ"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="500"
      Title="RegisterPage">
    <Grid Background="#F8F9FA">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">

            <TextBlock Text="Регистрация" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

            <TextBlock Text="Имя" FontSize="16" Margin="5"/>
            <TextBox x:Name="tbName" FontSize="16" Height="42"/>

            <TextBlock Text="Логин" FontSize="16" Margin="5"/>
            <TextBox x:Name="tbLogin" FontSize="16" Height="42"/>

            <TextBlock Text="Email" FontSize="16" Margin="5"/>
            <TextBox x:Name="tbEmail" FontSize="16" Height="42"/>

            <TextBlock Text="Пароль" FontSize="16" Margin="5"/>
            <PasswordBox x:Name="pbPassword" FontSize="16" Height="42"/>

            <Button Content="Зарегистрироваться" Height="55" FontSize="30" Margin="15" Background="#38A803" Foreground="White" Click="BtnRegister_Click"/>

            <Button Content="Назад" Height="40" FontSize="30" Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Page>
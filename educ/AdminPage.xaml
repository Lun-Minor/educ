<Page x:Class="educ.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Page.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" Width="100" BorderBrush="White" BorderThickness="0">
            <StackPanel Margin="5">
                <TextBlock Text="ШутИКроль" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

                <Button Width="35" Height="35" Background="White" BorderThickness="0" Margin="5" Click="BtnCatalog_Click">
                    <Image Source="https://i.pinimg.com/736x/98/dc/ee/98dcee92ed4314b979c7d09de33a95c3.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Каталог книг"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Background="White" Margin="5" BorderThickness="0" Click="BtnReadingLists_Click">
                    <Image Source="https://i.pinimg.com/736x/36/f2/7c/36f27c33c629c40f81f00ccb972a3e03.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Мои списки"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Margin="5" Background="White" BorderThickness="0" Click="BtnAdmin_Click"
                        Visibility="{Binding IsAdminVisible}">
                    <Image Source="https://i.pinimg.com/736x/8d/e0/de/8de0de491f34410526c83c8b1a7c62dc.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Администрирование"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Margin="5" Background="White" BorderThickness="0" Click="BtnProfile_Click">
                    <Image Source="https://i.pinimg.com/736x/fb/f3/9d/fbf39d8bc1ef7534ecb4144440533a8f.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Профиль"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Background="White" BorderThickness="0" Margin="5" Click="BtnLogout_Click">
                    <Image Source="https://i.pinimg.com/1200x/06/8f/71/068f711557f3e8f709f61783dea39212.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Выйти"/>
                    </Button.ToolTip>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="10" Orientation="Horizontal">
                <TextBlock Text="Администрирование" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbFilter" Width="280" Height="30" Margin="10" FontSize="17" SelectionChanged="cmbFilter_SelectionChanged">
                    <ComboBoxItem Content="Все заявки" Tag="All" IsSelected="True"/>
                    <ComboBoxItem Content="Жалобы" Tag="Complaints"/>
                    <ComboBoxItem Content="Заявки на автора" Tag="AuthorRequests"/>
                    <ComboBoxItem Content="Заявки на разморозку" Tag="Unfreeze"/>
                    <ComboBoxItem Content="Пользователи" Tag="Users"/>
                    <ComboBoxItem Content="Замороженные книги" Tag="FrozenBooks"/>
                    <ComboBoxItem Content="Замороженные отзывы" Tag="FrozenReviews"/>
                </ComboBox>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
                <ListBox x:Name="lbItems" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="8" Background="White" CornerRadius="5" Padding="12" BorderBrush="#E0E0E0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Type}" FontSize="18" FontWeight="SemiBold" Margin="5"/>

                                    <TextBlock Text="{Binding Details}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="5"/>
                                    <TextBlock Text="{Binding FromUser}" FontSize="13"/>
                                    <TextBlock Text="{Binding TargetInfo}" FontSize="13" Margin="5" Visibility="{Binding TargetInfo, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text= "{Binding Reason}" FontSize="14" Foreground="Red" FontWeight ="SemiBold" TextWrapping="Wrap" Margin="5"/>
                                    <TextBlock Text="{Binding Date}" FontSize="12" Margin="5"/>

                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <Button Content="Принять" Background="ForestGreen" Foreground="White" Margin="5" Click="BtnApprove_Click" Tag="{Binding}" 
                                                Visibility="{Binding ShowTwoButtons}"/>
                                        <Button Content="Отклонить" Background="Orange" Foreground="White" Margin="5" Click="BtnReject_Click" Tag="{Binding}" 
                                                Visibility="{Binding ShowTwoButtons}"/>
                                        <Button Content="Заморозить" Background="Blue" Foreground="White" Margin="5" Click="BtnFreezeUser_Click" Tag="{Binding}"
                                                Visibility="{Binding ShowThreeButtons}"/>
                                        <Button Content="Сменить роль" Background="#6B8E23" Foreground="White" Margin="5" Click="BtnChangeRole_Click" Tag="{Binding}"
                                                Visibility="{Binding ShowThreeButtons}"/>
                                        <Button Content="Сменить пароль" Background="Orange" Foreground="White" Margin="5" Click="BtnChangePassword_Click" Tag="{Binding}"
                                                Visibility="{Binding ShowThreeButtons}"/>
                                        <Button Content="Разморозить" Background="Green" Foreground="White" Margin="5" Click="BtnUnfreeze_Click" Tag="{Binding}"
                                                Visibility="{Binding ShowOneButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
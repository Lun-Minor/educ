<Page x:Class="educ.ReadingListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="650" d:DesignWidth="1100"
      Title="Мои списки книг">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

       
        <Border Grid.Column="0" Background="White" Width="100" BorderBrush="White" BorderThickness="0">
            <StackPanel Margin="5">
                <TextBlock Text="ШутИКроль" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

                <Button Width="35" Height="35" Background="White" BorderThickness="0" Margin="5"
                        ToolTipService.ShowDuration="5000" Click="BtnCatalog_Click">
                    <Image Source="https://i.pinimg.com/736x/98/dc/ee/98dcee92ed4314b979c7d09de33a95c3.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Каталог книг"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Background="White" Margin="5" BorderThickness="0"
                        ToolTipService.ShowDuration="5000" Click="BtnReadingLists_Click">
                    <Image Source="https://i.pinimg.com/736x/36/f2/7c/36f27c33c629c40f81f00ccb972a3e03.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Мои списки"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Background="White" Margin="5" BorderThickness="0"
                        ToolTipService.ShowDuration="5000" Click="BtnMyBooks_Click"
                        Visibility="{Binding IsAuthorVisible}">
                    <Image Source="https://i.pinimg.com/736x/61/c4/b8/61c4b8112ec61cb61044372324319e3d.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Мои книги"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Margin="5" Background="White" BorderThickness="0"
                        ToolTipService.ShowDuration="5000" Click="BtnAdmin_Click"
                        Visibility="{Binding IsAdminVisible}">
                    <Image Source="https://i.pinimg.com/736x/8d/e0/de/8de0de491f34410526c83c8b1a7c62dc.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Администрирование"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Margin="5" Background="White" BorderThickness="0"
                        ToolTipService.ShowDuration="5000" Click="BtnProfile_Click">
                    <Image Source="https://i.pinimg.com/736x/fb/f3/9d/fbf39d8bc1ef7534ecb4144440533a8f.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Профиль"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Background="White" BorderThickness="0"
                        ToolTipService.ShowDuration="5000" Click="BtnLogout_Click" Margin="5">
                    <Image Source="https://i.pinimg.com/1200x/06/8f/71/068f711557f3e8f709f61783dea39212.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Выйти"/>
                    </Button.ToolTip>
                </Button>
            </StackPanel>
        </Border>

        
        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="15">
                <TextBlock Text="Мои списки книг" FontSize="28" FontWeight="SemiBold" Margin="5"/>

                <StackPanel Orientation="Horizontal" Margin="5">
                    <ComboBox x:Name="cmbListType" Width="250" Height="35" SelectionChanged="cmbListType_SelectionChanged" Margin="5">
                        <ComboBoxItem Content="Читаю" Tag="2" IsSelected="True"/>
                        <ComboBoxItem Content="В планах" Tag="1"/>
                        <ComboBoxItem Content="Прочитано" Tag="3"/>
                        <ComboBoxItem Content="Заброшено" Tag="0"/>
                    </ComboBox>

                    <TextBox x:Name="tbSearch" Width="280" Height="35" FontSize="14" VerticalContentAlignment="Center" 
                             TextChanged="tbSearch_TextChanged" Margin="5"/>

                    <ComboBox x:Name="cmbSort" Width="220" Height="35" SelectionChanged="cmbSort_SelectionChanged">
                        <ComboBoxItem Content="По рейтингу от высокого" Tag="RatingDesc" IsSelected="True"/>
                        <ComboBoxItem Content="По рейтингу от низкого" Tag="RatingAsc"/>
                        <ComboBoxItem Content="По названию А-Я" Tag="NameAsc"/>
                        <ComboBoxItem Content="По названию Я-А" Tag="NameDesc"/>
                    </ComboBox>
                </StackPanel>

                
                <StackPanel Margin="5">
                    <TextBlock Text="Жанры:" FontSize="14" Margin="5"/>
                    <ScrollViewer Height="70" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="GenresPanel" Orientation="Horizontal"/>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>

            
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
                <ListBox x:Name="lbReadingList" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border MouseLeftButtonDown="BookCard_MouseLeftButtonDown" MouseRightButtonDown="BookCard_MouseRightButtonDown"
                                    Background="White" Margin="8" Width="220" Height="390">
                                <StackPanel>
                                    <Image Source="{Binding BookCover}" Height="250" Stretch="UniformToFill" Margin="5"/>
                                    <TextBlock Text="{Binding BookTitle}" FontSize="15" FontWeight="SemiBold" 
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="5"/>
                                    <TextBlock Text="{Binding BookAuthor}" FontSize="13" 
                                               TextAlignment="Center" Margin="5" Foreground="Gray"/>
                                    <TextBlock Text="{Binding BookRating, StringFormat='⭐{0:0.0}'}" 
                                               FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" 
                                               Margin="5" Foreground="Gold"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

<Page x:Class="educ.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:educ"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">


    <Grid>
        <Border Background="White" Margin="40" MaxWidth="440">

            <StackPanel>
                <TextBlock Text="Вход в аккаунт" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="25"/>

                
                <TextBlock Text="Логин" FontSize="17" Margin="5" />
                <TextBox x:Name="tbLogin" FontSize="16" Height="48" />


                <TextBlock Text="Пароль" FontSize="17" Margin="5" />
                <PasswordBox x:Name="pbPassword" FontSize="16" Height="48"/>

                <Button Content="Войти" Height="56" FontSize="27" Margin="5" Background="#60C2E2" Foreground="White" Click="BtnEnter_Click"/>

                
                <Button Content="Назад" Height="48" FontSize="27" Click="BtnBack_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
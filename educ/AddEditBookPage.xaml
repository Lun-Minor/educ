<Page x:Class="educ.AddEditBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:educ"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditBookPage">

    <Grid Background="White" Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Добавить новую книгу" FontSize="28" FontWeight="Bold" Margin="10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="700">
                
                <TextBlock Text="Название книги" FontWeight="SemiBold" Margin="5"/>
                <TextBox x:Name="tbTitle" Height="45" FontSize="16"/>

                <TextBlock Text="Жанры" FontWeight="Bold" Margin="5"/>
                <StackPanel x:Name="GenresPanel" Orientation="Horizontal" Margin="10"/>

                <TextBlock Text="Ссылка на обложку (URL)" FontWeight="Bold" Margin="5"/>
                <TextBox x:Name="tbCoverImage" Height="45" FontSize="15" />

                
                <TextBlock Text="Описание книги" FontWeight="Bold" Margin="5"/>
                <TextBox x:Name="tbDescription" Height="110" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="15"/>

                <TextBlock Text="Текст книги" FontWeight="Bold" Margin="5"/>
                <TextBox x:Name="tbTextContent" Height="220" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="15"/>
                
                <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                    <Button Content="Сохранить книгу" Width="200" Height="52" FontSize="16" Background="ForestGreen" Foreground="White" Click="BtnSave_Click"/>
                    <Button Content="Отмена" Width="140" Height="52" Margin="10" Click="BtnCancel_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
<Page x:Class="educ.ReadBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:educ"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReadBookPage">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <Border Grid.Column="0" Background="White" Width="100" BorderBrush="White" BorderThickness="0">
            <StackPanel Margin="5">
                <TextBlock Text="ШутИКроль" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

                <Button Width="35" Height="35" Background="White" BorderThickness="0" Margin="5" Click="BtnCatalog_Click">
                    <Image Source="https://i.pinimg.com/736x/98/dc/ee/98dcee92ed4314b979c7d09de33a95c3.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Каталог книг"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Background="White" Margin="5" BorderThickness="0" Click="BtnReadingLists_Click">
                    <Image Source="https://i.pinimg.com/736x/36/f2/7c/36f27c33c629c40f81f00ccb972a3e03.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Мои списки"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Background="White" Margin="5" BorderThickness="0" Click="BtnMyBooks_Click"
                        Visibility="{Binding IsAuthorVisible}">
                    <Image Source="https://i.pinimg.com/736x/61/c4/b8/61c4b8112ec61cb61044372324319e3d.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Мои книги"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Margin="5" Background="White" BorderThickness="0" Click="BtnAdmin_Click"
                        Visibility="{Binding IsAdminVisible}">
                    <Image Source="https://i.pinimg.com/736x/8d/e0/de/8de0de491f34410526c83c8b1a7c62dc.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Администрирование"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Margin="5" Background="White" BorderThickness="0" Click="BtnProfile_Click">
                    <Image Source="https://i.pinimg.com/736x/fb/f3/9d/fbf39d8bc1ef7534ecb4144440533a8f.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Профиль"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Background="White" BorderThickness="0" Margin="5" Click="BtnLogout_Click">
                    <Image Source="https://i.pinimg.com/1200x/06/8f/71/068f711557f3e8f709f61783dea39212.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Выйти"/>
                    </Button.ToolTip>
                </Button>
            </StackPanel>
        </Border>

       
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            
            <Border Margin="10">
                <TextBlock x:Name="txtBookTitle" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
            </Border>

            
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" >
                <TextBlock x:Name="txtBookContent" TextWrapping="Wrap" FontSize="16"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
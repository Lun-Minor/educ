<Page x:Class="educ.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:educ"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorPage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Page.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <Border Grid.Column="0" Background="White" Width="100" BorderBrush="White" BorderThickness="0">
            <StackPanel Margin="5">
                <TextBlock Text="ШутИКроль" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

                <Button Width="35" Height="35" Background="White" BorderThickness="0" Margin="5" Click="BtnCatalog_Click">
                    <Image Source="https://i.pinimg.com/736x/98/dc/ee/98dcee92ed4314b979c7d09de33a95c3.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Каталог книг"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Background="White" Margin="5" BorderThickness="0" Click="BtnReadingLists_Click">
                    <Image Source="https://i.pinimg.com/736x/36/f2/7c/36f27c33c629c40f81f00ccb972a3e03.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Мои списки"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Background="White" Margin="5" BorderThickness="0" Click="BtnMyBooks_Click"
                        Visibility="{Binding IsAuthorVisible}">
                    <Image Source="https://i.pinimg.com/736x/61/c4/b8/61c4b8112ec61cb61044372324319e3d.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Мои книги"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Margin="5" Background="White" BorderThickness="0" Click="BtnAdmin_Click"
                        Visibility="{Binding IsAdminVisible}">
                    <Image Source="https://i.pinimg.com/736x/8d/e0/de/8de0de491f34410526c83c8b1a7c62dc.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Администрирование"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Margin="5" Background="White" BorderThickness="0" Click="BtnProfile_Click">
                    <Image Source="https://i.pinimg.com/736x/fb/f3/9d/fbf39d8bc1ef7534ecb4144440533a8f.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Профиль"/>
                    </Button.ToolTip>
                </Button>

                <Button Width="35" Height="35" Background="White" BorderThickness="0" Margin="5" Click="BtnLogout_Click">
                    <Image Source="https://i.pinimg.com/1200x/06/8f/71/068f711557f3e8f709f61783dea39212.jpg" Width="32" Height="32"/>
                    <Button.ToolTip>
                        <ToolTip Content="Выйти"/>
                    </Button.ToolTip>
                </Button>
            </StackPanel>
        </Border>

        
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="Мои книги" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="Добавить новую книгу" Margin="10" Background="ForestGreen" Foreground="White" FontSize="15" Click="BtnAddBook_Click"/>
            </StackPanel>

            
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="lbMyBooks" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="5" Background="White" BorderThickness="1" MouseLeftButtonDown="BookCard_MouseLeftButtonDown">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{Binding CoverImage}" Width="100" Height="130" Stretch="UniformToFill" Margin="5"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding AverageRating, StringFormat='⭐ {0:0.0}'}" Foreground="Gold" Margin="5"/>
                                        <TextBlock Text="{Binding Description}" FontSize="14" MaxHeight="40" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10">
                                        <Button Content="Редактировать" Margin="5" Click="BtnEditBook_Click" Width="140" Height="40" FontSize="15" Tag="{Binding Id}"/>
                                        <Button Content="Удалить книгу" Margin="5" Background="Red" Foreground="White" Width="130" Height="40" FontSize="15"
                                                Click="BtnDeleteBook_Click" Tag="{Binding Id}"/>
                                        <Button Content="Оспорить заморозку" Background="Orange" Width="180" Height="40" FontSize="15"
                                                Visibility="{Binding IsFrozen, Converter={StaticResource BoolToVisibility}}" Click="BtnUnfreezeBook_Click" Tag="{Binding Id}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>